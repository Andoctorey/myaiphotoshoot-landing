{
  "name": "myaiphotoshoot-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run test:pricing && npm run test:geo && npm run test:security && npm run test:masks && npm run test:build-cache && node scripts/clear-next-fetch-cache.js && next build && node scripts/prune-unpublished-mask-routes.mjs && node scripts/fix-html-lang.js && node scripts/apply-csp.js && npm run test:geo-export",
    "start": "next start",
    "lint": "next lint",
    "test:indexnow": "node --test tests/submit-indexnow.test.mjs",
    "test:localized-blog": "node --test tests/localized-blog-alias.test.mjs",
    "test:pricing": "node --test tests/pricing-contract.test.mjs",
    "test:geo": "node --test tests/homepage-geo.test.mjs",
    "test:geo-export": "node --test tests/homepage-geo-export.test.mjs",
    "test:json-ld": "node --test src/lib/json-ld.test.mjs",
    "test:masks": "node --test scripts/prune-unpublished-mask-routes.test.mjs src/lib/ai-mask-landing-validation.test.mjs tests/mask-category-landings.test.mjs",
    "test:csp": "node --test scripts/apply-csp.test.js",
    "test:security": "npm run test:json-ld && npm run test:csp",
    "test:build-cache": "node --test scripts/clear-next-fetch-cache.test.js",
    "test:sitemap": "node --test tests/submit-sitemap.test.mjs",
    "test:worker": "node --experimental-default-type=module --test worker/deploy-proxy.test.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^173.0.0",
    "isomorphic-dompurify": "^3.19.0",
    "next": "^15.5.25",
    "next-intl": "^4.14.2",
    "node-fetch": "^3.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
