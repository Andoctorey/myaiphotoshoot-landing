    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test:indexnow": "node --test tests/submit-indexnow.test.mjs",
    "test:image-sitemap": "node --test tests/image-sitemap.test.mjs",
    "test:localized-blog": "node --test tests/localized-blog-alias.test.mjs",
    "test:pricing": "node --test tests/pricing-contract.test.mjs",
    "test:presets": "node --test tests/preset-test.test.mjs tests/preset-redirects.test.mjs tests/preset-app-links.test.mjs",
    "test:use-cases": "node --test src/lib/use-cases-index.test.mjs",
    "test:use-cases-export": "node --test tests/use-cases-export.test.mjs",
    "test:geo": "node --test tests/homepage-geo.test.mjs",
    "test:geo-export": "node --test tests/homepage-geo-export.test.mjs",
    "test:json-ld": "node --test src/lib/json-ld.test.mjs",
    "test:masks": "node --test scripts/prune-unpublished-mask-routes.test.mjs src/lib/ai-mask-landing-validation.test.mjs tests/mask-category-landings.test.mjs tests/mask-app-links.test.mjs",
    "test:csp": "node --test scripts/apply-csp.test.js",
    "test:security": "npm run test:json-ld && npm run test:csp",
    "test:build-cache": "node --test scripts/clear-next-fetch-cache.test.js tests/blog-post-build-cache.test.mjs",
    "test:sitemap": "node --test tests/submit-sitemap.test.mjs",
    "test:search-prechecks": "node --test tests/search-submission-precheck.test.mjs",
    "test:worker": "node --test worker/deploy-proxy.test.js"
